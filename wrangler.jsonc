{
  "name": "skc-college",
  "compatibility_date": "2026-07-03",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skc_db",
      "database_id": "a6d2f0c3-9152-4e46-8190-1b30cea6dc7d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "skc-media"
    }
  ],
  "routes": [
    {
      "pattern": "skc.college",
      "custom_domain": true
    },
    {
      "pattern": "www.skc.college",
      "custom_domain": true
    }
  ]
}
